{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ippuku-kanri",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ippuku-orders",
      "database_id": "5e0f625c-c0a0-455e-8f55-a3d32b424cb6"
    }
  ]
}
